{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/record_session.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/record_session.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run scripts/lint.py:*)",
      "Bash(uv run --quiet scripts/lint.py:*)",
      "Bash(uv run scripts/new.py:*)",
      "Bash(uv run scripts/tests/test_lint.py:*)"
    ]
  }
}
